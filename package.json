{
  "name": "salvee-html",
  "private": true,
  "version": "1.8.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd server && node --watch index.js",
    "dev:all": "concurrently -n FRONTEND,BACKEND -c blue,green \"vite\" \"npm run dev --prefix server\"",
    "build": "node scripts/versao.mjs check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "versao:check": "node scripts/versao.mjs check",
    "versao:changelog": "node scripts/versao.mjs changelog",
    "start": "node server/index.js",
    "postinstall": "npm install --prefix server --omit=dev"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@vitest/ui": "^2.1.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.5",
    "jsdom": "^25.0.0",
    "postcss": "^8.5.12",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "lucide": "^0.460.0"
  }
}
