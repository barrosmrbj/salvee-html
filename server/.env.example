PORT=8000
JWT_SECRET=salvee-dev-secret-change-in-prod

# SQLite (padrão local — não alterar)
# DB_CLIENT=better-sqlite3

# MySQL (Hostinger — descomentar e preencher)
# DB_CLIENT=mysql2
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=seu_usuario
# DB_NAME=salvee
# DB_PASSWORD=sua_senha

# Produção (Hostinger)
# CORS_ORIGIN=https://skyblue-hedgehog-581364.hostingersite.com   # domínios do frontend, separados por vírgula
# UPLOAD_DIR=/home/u526770669/salvee-uploads   # pasta das imagens fora do app (sobrevive ao redeploy)
# PUBLIC_URL=https://skyblue-hedgehog-581364.hostingersite.com # base das URLs de /uploads

# Login social (opcional — cada provedor só aparece ativo quando as variáveis dele existem)
# Retorno a cadastrar no provedor: <PUBLIC_URL ou http://localhost:8000>/api/auth/oauth/<google|facebook|apple>/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# APPLE_CLIENT_ID=        # Services ID (ex.: com.salvee.web)
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=      # conteúdo do arquivo .p8 numa linha, com 
 no lugar das quebras
# APP_URL=                # frontend para onde o login volta (padrão: mesmo domínio; dev: http://localhost:5173)
