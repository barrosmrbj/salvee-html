# Hostinger: o Git implanta a master inteira no public_html (sem build).
# O site publicado é o build em dist/ (gerado com `npm run build` e commitado).
# Toda requisição é servida de dist/ — o index.html da raiz (dev, carrega /src/main.ts)
# e o código-fonte (src/, server/ etc.) ficam inacessíveis pela web.
Options -Indexes -MultiViews
DirectoryIndex index.html

RewriteEngine On
RewriteCond %{REQUEST_URI} !^/dist/
RewriteRule ^(.*)$ dist/$1 [L]
