# Site estático da Hostinger (Git → public_html, sem build): serve o build do frontend
# em server/public/ (gerado com `npm run build` e commitado). O index.html da raiz (dev,
# carrega /src/main.ts) e o código-fonte ficam inacessíveis pela web.
# No Node.js App este arquivo não é usado: o Express serve server/public/.
Options -Indexes -MultiViews
DirectoryIndex index.html

RewriteEngine On
RewriteCond %{REQUEST_URI} !^/server/public/
RewriteRule ^(.*)$ server/public/$1 [L]
